# Build output
bin/
obj/
**/bin/
**/obj/
[Dd]ebug/
[Rr]elease/
TestResults/
*.user
.vs/

# Older layouts generated the native messaging manifest here. install.ps1 now writes it to
# %LOCALAPPDATA%\WindowsDownloader and deletes any leftover copy, but keep this so an
# old working tree can never commit one.
packaging/native_host.json

# Host debug log, if anyone points --log-path at the repo
*.log

# Editors / OS
.vscode/
.idea/
Thumbs.db
Desktop.ini

# Extension signing key. The ID is derived from its public half (committed in the manifest);
# the private half proves updates come from you. Losing it means a new ID and a broken install
# for every user, so back it up somewhere safe -- but never here.
*.pem
*.p12
*.crx

# MSIX staging output
packaging/msix/
